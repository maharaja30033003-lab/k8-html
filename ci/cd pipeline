12. GitHub Actions workflow

File:

.github/workflows/docker-build.yml

Use:

name: Build and Push Docker Image

on:
  push:
    branches:
      - main

jobs:
  docker:
    runs-on: self-hosted

    steps:

      - name: Checkout code
        uses: actions/checkout@v4

      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      - name: Build Docker image
        run: |
          docker build -t ${{ secrets.DOCKER_USERNAME }}/k8-html:v1 .

      - name: Push Docker image
        run: |
          docker push ${{ secrets.DOCKER_USERNAME }}/k8-html:v1

      - name: Deploy to Kubernetes
        run: |
          kubectl apply -f k8/deployment.yml
          kubectl rollout status deployment/html-app
          kubectl get pods -o wide
          kubectl get service html-service
